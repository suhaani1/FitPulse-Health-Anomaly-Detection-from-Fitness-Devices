        "def detect_residual_anomalies(df, column, window=7, quantile=0.99):\n",
        "    trend = (\n",
        "        df[column]\n",
        "        .rolling(window=window, min_periods=1)\n",
        "        .mean()\n",
        "    )\n",
        "\n",
        "    residual = df[column] - trend\n",
        "    threshold = residual.abs().quantile(quantile)\n",
        "    anomaly = residual.abs() > threshold\n",
        "\n",
        "    return trend, residual, anomaly\n"
      ],
